NODE_ENV=development
PORT=5000

# MongoDB local :
MONGODB_URI=mongodb://127.0.0.1:27017/office_management
# MongoDB Atlas (copiez l'URI « Drivers » de votre cluster) :
# MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Base utilisée si l'URI n'en précise pas (cas des URI Atlas)
MONGODB_DB=office_management

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Nombre de proxys devant l'API en production (1 derrière Render/Railway/Nginx)
TRUST_PROXY=0

CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:8081,http://localhost:5173

# Site public : base des liens des emails du compte client
PUBLIC_SITE_URL=http://localhost:8080

# Cloudinary (stockage des médias et pièces jointes)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails sortants (nodemailer)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Facultatif : expéditeur affiché et destinataire des notifications internes
EMAIL_FROM=
EMAIL_FROM_NAME=Office Management
EMAIL_ADMIN=
